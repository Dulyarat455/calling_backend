// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Book{
  id Int @id() @default(autoincrement())
  isbn String
  name String
  price Int
}


model Groups{
  id Int @id() @default(autoincrement())
  name String
  State String  @default("use")
  createdAt DateTime @default(now())
  updateAt DateTime @default(now())
  UserGroups UserGroups[]
  Machines Machines[]
  CallNodes CallNodes[]
  FlowJob FlowJob[]
  Job Job[]
}

model User{
  id Int @id() @default(autoincrement())
  username String?
  name String
  password String
  empNo String
  role String
  rfId String
  status String    //"active", "inactive"
  accountState String @default("use")   // "use", "delete" 
  UserGroups UserGroups[]
  UserSections UserSections[]
  Job Job[]
  TimeStateJob TimeStateJob[]
}

model UserGroups{
  id Int @id() @default(autoincrement())
  userId  Int
  groupId Int
  State String  @default("use")
  User User @relation(fields: [userId],references: [id])
  Groups Groups @relation(fields: [groupId],references: [id])
  
}


model UserSections{
  id Int @id() @default(autoincrement())
  userId  Int
  sectionId  Int
  subSectionId Int
  State String  @default("use")
  User User @relation(fields: [userId], references: [id])
  Section Sections @relation(fields: [sectionId], references: [id])
  SubSections SubSections @relation(fields: [subSectionId],references: [id])

}

model CallNodes{
   id Int @id() @default(autoincrement())
   code String 
   subSectionId Int
   sectionId Int
   groupId Int
   isActive Int @default(1)
   State String  @default("use")
   Sections Sections @relation(fields: [sectionId], references: [id])
   Groups Groups @relation(fields: [groupId],references: [id]) 
   SubSections SubSections @relation(fields: [subSectionId],references: [id])
   fromJobs Job[] @relation("JobFromNode")
   toJobs Job[] @relation("JobToNode")
   fromFlowJobs FlowJob[] @relation("FlowJobFromNode")
   toFlowJobs FlowJob[] @relation("FlowJobToNode")
}



model Machines{
  id Int @id() @default(autoincrement())
  code String
  groupId Int
  isActive Int @default(1)
  State String  @default("use")
  Groups Groups @relation(fields: [groupId], references: [id])
  Job Job[]
}


model Sections {
  id Int @id() @default(autoincrement())
  name  String
  State String @default("use")
  createdAt DateTime @default(now())
  updateAt DateTime @default(now())
  Users UserSections[]
  CallNodes CallNodes[]
  MapSections MapSections[]
}


model SubSections{
  id Int @id() @default(autoincrement())
  name String
  State String @default("use")
  createAt DateTime @default(now())
  updateAt DateTime @default(now())
  CallNodes CallNodes[]
  UserSections UserSections[]
  MapSections MapSections[]
}

model MapSections{
  id Int  @id() @default(autoincrement())
  sectionId Int
  subSectionId Int
  Sections Sections  @relation(fields: [sectionId], references: [id])
  SubSections SubSections @relation(fields: [subSectionId], references: [id])
}


model Job {
  id Int @id() @default(autoincrement())
  groupId Int
  machineId Int
  fromNodeId Int
  toNodeId Int
  createByUserId Int
  createAt DateTime @default(now())
  remark String?
  priority String?
  State String @default("use")
  fromNode CallNodes  @relation("JobFromNode", fields: [fromNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toNode CallNodes  @relation("JobToNode", fields: [toNodeId], references: [id], onDelete: NoAction,onUpdate: NoAction)
  User User @relation(fields: [createByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Groups Groups @relation(fields: [groupId], references: [id],onDelete: NoAction, onUpdate: NoAction)
  Machines Machines @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction )
  TimeStateJob TimeStateJob[]
  JobRecord JobRecord[]
} 

model TimeStateJob {
  id Int @id() @default(autoincrement())
  date DateTime
  stateJobId Int 
  jobId Int
  userInchargeId Int
  State String @default("use")
  User User @relation(fields: [userInchargeId], references: [id],  onDelete: NoAction, onUpdate: NoAction)
  Job Job @relation(fields: [jobId], references: [id])
  StateJob StateJob @relation(fields: [stateJobId], references: [id])
}


model JobRecord {
  id Int @id() @default(autoincrement())
  jobNo String?     
  groupName String
  machineName String
  createByUserName String
  remark String
  fromNodeName String
  toNodeName String
  jobId Int
  State String @default("use")
  Job Job @relation(fields: [jobId], references: [id])
}

model StateJob{
  id Int @id() @default(autoincrement())
  name String
  State String @default("use")
  TimeStateJob TimeStateJob[]
}

model FlowJob{
  id Int @id() @default(autoincrement())
  groupId Int
  fromNodeId Int
  toNodeId Int
  State String @default("use")
  status String // active
  Groups Groups @relation(fields: [groupId], references: [id])
  fromNode CallNodes  @relation("FlowJobFromNode", fields: [fromNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toNode CallNodes  @relation("FlowJobToNode", fields: [toNodeId], references: [id], onDelete: NoAction,onUpdate: NoAction)

}


model Urgent{
  id Int @id() @default(autoincrement())
  name String
  State String @default("use")
}















